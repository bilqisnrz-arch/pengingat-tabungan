* { box-sizing: border-box; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; }

body { background-color: rgb(244, 247, 254); display: flex; justify-content: center; padding: 20px; }

.card { background: rgb(255, 255, 255); padding: 25px; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 15px; width: 100%; max-width: 450px; }

h2 { color: rgb(43, 54, 116); margin-bottom: 20px; text-align: center; }

.form-group { margin-bottom: 15px; }

label { display: block; font-weight: 600; color: rgb(67, 24, 255); margin-bottom: 5px; font-size: 14px; }

input { width: 100%; padding: 10px; border: 1px solid rgb(224, 229, 242); border-radius: 8px; outline: none; }

button { width: 100%; padding: 12px; background: rgb(67, 24, 255); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px; }

button:hover { background: rgb(51, 17, 219); }

.result { margin-top: 25px; border-top: 2px dashed rgb(224, 229, 242); padding-top: 15px; }

.progress-bar { width: 100%; background: rgb(239, 244, 251); border-radius: 10px; height: 15px; overflow: hidden; margin: 10px 0px; }

.progress { width: 0%; height: 100%; background: rgb(5, 205, 153); transition: width 0.3s; }

.info-box { background: rgb(244, 247, 254); padding: 10px; border-radius: 8px; margin-top: 10px; font-size: 14px; color: rgb(43, 54, 116); }
