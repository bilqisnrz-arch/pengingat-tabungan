  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pengingat &amp; Target Tabungan</title>
  
</head>
  <body>

<div class="card">
  <h2><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">🎯 Target Tabungan</font></font></h2>
  
  <div class="form-group">
    <label for="goalName"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Nama Target</font></font></label>
    <input type="text" id="goalName" placeholder="Contoh: Beli Laptop Baru">
  </div>
  
  <div class="form-group">
    <label for="targetAmount"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Target Jumlah (Rp)</font></font></label>
    <input type="number" id="targetAmount" placeholder="10000000">
  </div>

  <div class="form-group">
    <label for="currentAmount"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Uang Saat Ini (Rp)</font></font></label>
    <input type="number" id="currentAmount" placeholder="0">
  </div>

  <div class="form-group">
    <label for="days"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Target Waktu (Hari)</font></font></label>
    <input type="number" id="days" placeholder="30">
  </div>

  <button><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Hitung Target &amp; Aktifkan Pengingat</font></font></button>

  <div class="result" id="resultBox" style="display: none;">
    <h3 id="resGoalName" style="color: #2b3674; margin: 0;"></h3>
    <div class="progress-bar">
      <div class="progress" id="progressBar"></div>
    </div>
    <p id="progressText" style="font-size: 12px; color: #a3edda; color: #707ebe; text-align: right; margin: 0;"></p>
    
    <div class="info-box">
      <p><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">💡 **Rekomendasi Tabungan:**</font></font></p>
      <ul>
        <li><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Harian: </font></font><b id="dailySavings"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Rp 0</font></font></b></li>
        <li><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Mingguan: </font></font><b id="weeklySavings"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Rp 0</font></font></b></li>
      </ul>
    </div>
  </div>
</div>





